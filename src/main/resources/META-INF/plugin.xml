<idea-plugin url="https://github.com/porotkin/gradle-lens">
    <id>com.github.porotkin.gradlelens</id>
    <name>Gradle Lens</name>
    <vendor url="https://github.com/porotkin">porotkin</vendor>

    <!-- language=HTML -->
    <description><![CDATA[
        Shows the Gradle <code>description</code> of a module next to its folder in the Project view.
        <ul>
            <li>Project view <b>⋮</b> → <b>Appearance</b> → <b>Module Descriptions</b>: <b>All Modules</b>, <b>Selected
                Modules</b> or <b>None</b>.
            </li>
            <li><b>Edit Module Description</b> (<b>Shift+Enter</b>) in the context menu of a module
                folder writes the description where the module declares it, its <code>build.gradle.kts</code> or
                <code>gradle.properties</code>, and shows it right away, without waiting for a Gradle sync.
            </li>
            <li><b>Quick Documentation</b> on a module folder lists the Gradle modules that depend on it; click one to
                open where it declares the dependency, also in other builds of a composite build, by coordinates or a
                version catalog entry.
            </li>
            <li>Marks the unused and undeclared dependencies that
                <a href="https://github.com/porotkin/dependency-lens">Dependency Lens</a> reports, in
                <code>build.gradle.kts</code>.
            </li>
        </ul>
        <p><a href="https://github.com/porotkin/gradle-lens/issues">Report an issue</a></p>
        ]]></description>

    <change-notes><![CDATA[
        <ul>
            <li>New: <b>Remove dependency</b> quick-fix for an unused dependency reported by
                <a href="https://github.com/porotkin/dependency-lens">Dependency Lens</a>.
            </li>
            <li>New: unused <code>api</code> dependencies are marked too, as a weak warning, since consumers may still
                need them.
            </li>
            <li>Dependency Lens findings now mark the whole declaration, with one tooltip per issue that lists each
                finding on its own line.
            </li>
        </ul>
        ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.gradle</depends>
    <depends>org.jetbrains.plugins.gradle</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.properties</depends>
    <depends>org.toml.lang</depends>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <projectViewNodeDecorator implementation="gradlelens.description.ModuleDescriptionDecorator"/>
        <postStartupActivity implementation="gradlelens.model.LoadGradleModelOnStartup"/>
        <postStartupActivity implementation="gradlelens.description.AttachProjectViewSelection"/>
        <documentationProvider implementation="gradlelens.dependencies.ModuleDependenciesDocumentationProvider"/>
        <localInspection language="kotlin" shortName="DependencyLens" displayName="Dependency Lens findings"
                         groupName="Gradle" enabledByDefault="true" level="WARNING"
                         implementationClass="gradlelens.dependencylens.DependencyLensInspection"/>
        <externalSystemTaskNotificationListener
                implementation="gradlelens.dependencylens.RefreshFindingsAfterGradleTask"/>
    </extensions>

    <projectListeners>
        <listener class="gradlelens.model.ReloadGradleModelOnSync"
                  topic="com.intellij.openapi.externalSystem.service.project.manage.ProjectDataImportListener"/>
        <listener class="gradlelens.description.RefreshOnModulesChanged"
                  topic="gradlelens.model.GradleModulesListener"/>
        <listener class="gradlelens.description.RefreshOnSelectionChange"
                  topic="com.intellij.ide.projectView.impl.ProjectViewListener"/>
        <listener class="gradlelens.dependencylens.RehighlightOnFindingsChange"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListenerBackgroundable"/>
        <listener class="gradlelens.dependencylens.RehighlightOnModulesChanged"
                  topic="gradlelens.model.GradleModulesListener"/>
    </projectListeners>

    <actions>
        <action id="com.github.porotkin.gradlelens.EditModuleDescription"
                class="gradlelens.description.EditModuleDescriptionAction"
                text="Edit Module Description…"
                description="Edit the Gradle description of this module in its build script">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="RenameElement"/>
            <keyboard-shortcut keymap="$default" first-keystroke="shift ENTER"/>
        </action>
        <group id="com.github.porotkin.gradlelens.ModuleDescriptions" text="Module Descriptions" popup="true">
            <add-to-group group-id="ProjectView.ToolWindow.Appearance.Actions"/>
            <action id="com.github.porotkin.gradlelens.ShowAllModuleDescriptions"
                    class="gradlelens.description.ShowAllModuleDescriptionsAction"
                    text="All Modules"/>
            <action id="com.github.porotkin.gradlelens.ShowSelectedModuleDescriptions"
                    class="gradlelens.description.ShowSelectedModuleDescriptionsAction"
                    text="Selected Modules"/>
            <action id="com.github.porotkin.gradlelens.HideModuleDescriptions"
                    class="gradlelens.description.HideModuleDescriptionsAction"
                    text="None"/>
        </group>
    </actions>
</idea-plugin>
